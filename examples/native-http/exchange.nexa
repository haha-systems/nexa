nexa 0.3
module example.native_http.exchange

import request
import response

export type Exchange is complete(request is Bytes, response is response.Response, remainder is Bytes) |
  request_error(error is String) |
  response_error(request is Bytes, error is String) |
  needs_more(request is Bytes)

fn read_chunks(chunks is List[Bytes], eof is Bool) -> response.Step {
  let count = list.len(chunks)
  var cursor = 0
  var progress = response.State.start()
  while cursor < count {
    let chunk = list.get(chunks, cursor)
    cursor = cursor + 1
    match response.decode(progress, chunk, false) {
      response.Step.needs_more(next: next) => {
        progress = next
      }
      response.Step.malformed(error: error) => {
        return response.Step.malformed(error: error)
      }
      response.Step.complete(value: value, remainder: remainder) => {
        var unread = remainder
        while cursor < count {
          unread = bytes.concat(unread, list.get(chunks, cursor))
          cursor = cursor + 1
        }
        return response.Step.complete(value: value, remainder: unread)
      }
    }
  }
  return response.decode(progress, hex"", eof)
}

export fn exchange(authority is Bytes, target is Bytes, chunks is List[Bytes], eof is Bool) -> Exchange {
  match request.encode(authority, target) {
    Result.err(error: error) => {
      return Exchange.request_error(error: error)
    }
    Result.ok(value: wire) => {
      match read_chunks(chunks, eof) {
        response.Step.needs_more(next: _next) => {
          return Exchange.needs_more(request: wire)
        }
        response.Step.malformed(error: error) => {
          return Exchange.response_error(request: wire, error: error)
        }
        response.Step.complete(value: value, remainder: remainder) => {
          return Exchange.complete(request: wire, response: value, remainder: remainder)
        }
      }
    }
  }
}
