nexa 0.3
module example.native_http.exchange

import request
import stream
import result

export fn exchange(authority is Bytes, target is Bytes, chunks is List[Bytes], eof is Bool) -> result.Exchange {
  match request.encode(authority, target) {
    Result.err(error: error) => {
      return result.Exchange.request_error(error: error)
    }
    Result.ok(value: wire) => {
      return result.assemble(Result.ok(value: wire), stream.decode(chunks, eof))
    }
  }
}
