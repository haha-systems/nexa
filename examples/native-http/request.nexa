nexa 0.3
module example.native_http.request

import decimal

fn valid_decimal_part(value is Bytes, minimum is Int, maximum is Int) -> Bool {
  let length = bytes.len(value)
  if length == 0 or (length > 1 and bytes.at(value, 0) == 48) {
    return false
  }
  match decimal.scan(value, maximum) {
    Result.ok(value: number) => {
      return number >= minimum
    }
    Result.err(error: _error) => {
      return false
    }
  }
}

fn valid_authority(authority is Bytes) -> Bool {
  let length = bytes.len(authority)
  if length < 7 or length > 21 {
    return false
  }

  var start = 0
  var cursor = 0
  var dots = 0
  while cursor < length {
    let byte = bytes.at(authority, cursor)
    if byte == 46 {
      if dots == 3 or not valid_decimal_part(bytes.slice(authority, start, cursor), 0, 255) {
        return false
      }
      dots = dots + 1
      start = cursor + 1
    } else if byte == 58 {
      return dots == 3 and valid_decimal_part(bytes.slice(authority, start, cursor), 0, 255) and
        valid_decimal_part(bytes.slice(authority, cursor + 1, length), 1, 65535)
    }
    cursor = cursor + 1
  }
  return dots == 3 and valid_decimal_part(bytes.slice(authority, start, length), 0, 255)
}

fn hex_digit(byte is Int) -> Bool {
  return (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 70) or (byte >= 97 and byte <= 102)
}

fn target_octet(byte is Int) -> Bool {
  // URI unreserved characters, sub-delimiters, and the origin-form separators.
  return (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or
    byte == 45 or byte == 46 or byte == 95 or byte == 126 or byte == 33 or byte == 36 or byte == 38 or
    byte == 39 or byte == 40 or byte == 41 or byte == 42 or byte == 43 or byte == 44 or byte == 59 or
    byte == 61 or byte == 58 or byte == 64 or byte == 47 or byte == 63
}

fn valid_target(target is Bytes) -> Bool {
  let length = bytes.len(target)
  if length == 0 or length > 4096 or bytes.at(target, 0) != 47 {
    return false
  }

  var cursor = 1
  while cursor < length {
    let byte = bytes.at(target, cursor)
    if byte == 37 {
      if cursor + 2 >= length or not hex_digit(bytes.at(target, cursor + 1)) or
        not hex_digit(bytes.at(target, cursor + 2)) {
        return false
      }
      cursor = cursor + 3
    } else {
      if not target_octet(byte) {
        return false
      }
      cursor = cursor + 1
    }
  }
  return true
}

export fn encode(authority is Bytes, target is Bytes) -> Result[Bytes, String] {
  if not valid_authority(authority) {
    return Result.err(error: "invalid_authority")
  }
  if not valid_target(target) {
    return Result.err(error: "invalid_target")
  }

  let start = bytes.concat(bytes.encode_utf8("GET "), target)
  let host = bytes.concat(bytes.encode_utf8(" HTTP/1.1\r\nHost: "), authority)
  let close = bytes.encode_utf8("\r\nConnection: close\r\n\r\n")
  return Result.ok(value: bytes.concat(bytes.concat(start, host), close))
}
