{
  "$defs": {
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/Endpoint"
        },
        "to": {
          "$ref": "#/$defs/Endpoint"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "DraftNode": {
      "additionalProperties": false,
      "properties": {
        "export": {
          "$ref": "#/$defs/Identifier"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "selector": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "selector",
        "export"
      ],
      "type": "object"
    },
    "DraftSchema": {
      "enum": [
        "nexa.blueprint-draft/0.3"
      ],
      "type": "string"
    },
    "EmptyList": {
      "maxItems": 0,
      "type": "array"
    },
    "Endpoint": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "input",
              "type": "string"
            },
            "port": {
              "$ref": "#/$defs/Identifier"
            }
          },
          "required": [
            "kind",
            "port"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "node",
              "type": "string"
            },
            "node": {
              "$ref": "#/$defs/Identifier"
            },
            "port": {
              "$ref": "#/$defs/Identifier"
            }
          },
          "required": [
            "kind",
            "node",
            "port"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "output",
              "type": "string"
            },
            "port": {
              "$ref": "#/$defs/Identifier"
            }
          },
          "required": [
            "kind",
            "port"
          ],
          "type": "object"
        }
      ]
    },
    "Identifier": {
      "not": {
        "anyOf": [
          {
            "enum": [
              "nexa",
              "module",
              "import",
              "export",
              "as",
              "type",
              "alias",
              "interface",
              "impl",
              "fn",
              "action",
              "effects",
              "let",
              "var",
              "state",
              "return",
              "if",
              "else",
              "match",
              "for",
              "in",
              "while",
              "break",
              "continue",
              "true",
              "false",
              "none",
              "unit",
              "and",
              "or",
              "not",
              "is",
              "main",
              "effect",
              "requires",
              "policy",
              "allow",
              "deny",
              "ask",
              "abstain",
              "when",
              "otherwise",
              "identity",
              "agent",
              "group",
              "grant",
              "revoke",
              "pulse",
              "run",
              "blueprint",
              "input",
              "output",
              "node",
              "connect",
              "after",
              "set",
              "memory",
              "on",
              "emit",
              "task",
              "spawn",
              "await",
              "scope",
              "defer"
            ]
          },
          {
            "pattern": "[\\r\\n]"
          }
        ]
      },
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "type": "string"
    },
    "Language": {
      "enum": [
        "0.3"
      ],
      "type": "string"
    },
    "OrderEdge": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/Identifier"
        },
        "before": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "type": "object"
    },
    "Port": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/Identifier"
        },
        "type": {
          "$ref": "#/$defs/ValueType"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "type": "object"
    },
    "Profile": {
      "enum": [
        "slice0"
      ],
      "type": "string"
    },
    "ValueType": {
      "enum": [
        "String",
        "Unit"
      ],
      "type": "string"
    }
  },
  "$id": "https://nexa.invalid/schemas/blueprint-draft-0.3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "connections": {
      "items": {
        "$ref": "#/$defs/Connection"
      },
      "type": "array"
    },
    "entry": {
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/Port"
      },
      "type": "array"
    },
    "language": {
      "$ref": "#/$defs/Language"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/DraftNode"
      },
      "type": "array"
    },
    "order_edges": {
      "items": {
        "$ref": "#/$defs/OrderEdge"
      },
      "type": "array"
    },
    "output": {
      "$ref": "#/$defs/Port"
    },
    "profile": {
      "$ref": "#/$defs/Profile"
    },
    "requirements": {
      "$ref": "#/$defs/EmptyList"
    },
    "schema": {
      "$ref": "#/$defs/DraftSchema"
    },
    "settings": {
      "$ref": "#/$defs/EmptyList"
    }
  },
  "required": [
    "schema",
    "language",
    "profile",
    "entry",
    "inputs",
    "output",
    "nodes",
    "connections",
    "order_edges",
    "settings",
    "requirements"
  ],
  "title": "BlueprintDraft",
  "type": "object"
}
