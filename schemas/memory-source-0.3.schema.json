{
  "$defs": {
    "DependencyRequest": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "$ref": "#/$defs/Identifier"
        },
        "selector": {
          "type": "string"
        }
      },
      "required": [
        "alias",
        "selector"
      ],
      "type": "object"
    },
    "Identifier": {
      "not": {
        "anyOf": [
          {
            "enum": [
              "nexa",
              "module",
              "import",
              "export",
              "as",
              "type",
              "alias",
              "interface",
              "impl",
              "fn",
              "action",
              "effects",
              "let",
              "var",
              "state",
              "return",
              "if",
              "else",
              "match",
              "for",
              "in",
              "while",
              "break",
              "continue",
              "true",
              "false",
              "none",
              "unit",
              "and",
              "or",
              "not",
              "is",
              "main",
              "effect",
              "requires",
              "policy",
              "allow",
              "deny",
              "ask",
              "abstain",
              "when",
              "otherwise",
              "identity",
              "agent",
              "group",
              "grant",
              "revoke",
              "pulse",
              "run",
              "blueprint",
              "input",
              "output",
              "node",
              "connect",
              "after",
              "set",
              "memory",
              "on",
              "emit",
              "task",
              "spawn",
              "await",
              "scope",
              "defer"
            ]
          },
          {
            "pattern": "[\\r\\n]"
          }
        ]
      },
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "type": "string"
    },
    "SourceSchema": {
      "enum": [
        "nexa.memory-source/0.3"
      ],
      "type": "string"
    }
  },
  "$id": "https://nexa.invalid/schemas/memory-source-0.3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dependencies": {
      "items": {
        "$ref": "#/$defs/DependencyRequest"
      },
      "type": "array"
    },
    "entry": {
      "$ref": "#/$defs/Identifier"
    },
    "kernel": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "schema": {
      "$ref": "#/$defs/SourceSchema"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "name",
    "version",
    "module",
    "sources",
    "entry",
    "kernel",
    "dependencies"
  ],
  "title": "SourceManifest",
  "type": "object"
}
