{
  "$defs": {
    "Digest": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Identifier": {
      "not": {
        "anyOf": [
          {
            "enum": [
              "nexa",
              "module",
              "import",
              "export",
              "as",
              "type",
              "alias",
              "interface",
              "impl",
              "fn",
              "action",
              "effects",
              "let",
              "var",
              "state",
              "return",
              "if",
              "else",
              "match",
              "for",
              "in",
              "while",
              "break",
              "continue",
              "true",
              "false",
              "none",
              "unit",
              "and",
              "or",
              "not",
              "is",
              "main",
              "effect",
              "requires",
              "policy",
              "allow",
              "deny",
              "ask",
              "abstain",
              "when",
              "otherwise",
              "identity",
              "agent",
              "group",
              "grant",
              "revoke",
              "pulse",
              "run",
              "blueprint",
              "input",
              "output",
              "node",
              "connect",
              "after",
              "set",
              "memory",
              "on",
              "emit",
              "task",
              "spawn",
              "await",
              "scope",
              "defer"
            ]
          },
          {
            "pattern": "[\\r\\n]"
          }
        ]
      },
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "type": "string"
    },
    "Language": {
      "enum": [
        "0.3"
      ],
      "type": "string"
    },
    "LockBinding": {
      "additionalProperties": false,
      "properties": {
        "export": {
          "$ref": "#/$defs/Identifier"
        },
        "memory": {
          "$ref": "#/$defs/Digest"
        },
        "selector": {
          "type": "string"
        }
      },
      "required": [
        "selector",
        "export",
        "memory"
      ],
      "type": "object"
    },
    "LockSchema": {
      "enum": [
        "nexa.lock/0.3"
      ],
      "type": "string"
    },
    "Profile": {
      "enum": [
        "slice0"
      ],
      "type": "string"
    }
  },
  "$id": "https://nexa.invalid/schemas/lock-0.3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bindings": {
      "items": {
        "$ref": "#/$defs/LockBinding"
      },
      "type": "array"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/Digest"
      },
      "type": "array"
    },
    "kernel": {
      "$ref": "#/$defs/Digest"
    },
    "language": {
      "$ref": "#/$defs/Language"
    },
    "profile": {
      "$ref": "#/$defs/Profile"
    },
    "schema": {
      "$ref": "#/$defs/LockSchema"
    }
  },
  "required": [
    "schema",
    "language",
    "profile",
    "kernel",
    "bindings",
    "dependencies"
  ],
  "title": "LockRecord",
  "type": "object"
}
